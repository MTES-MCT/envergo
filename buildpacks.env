# Build settings for the geo and Python buildpacks. Apply to Scalingo after any change, see README.
GDAL_VERSION=3.13.3
GEOS_VERSION=3.14.1
PROJ_VERSION=9.8.1
# Our own builds, in the layout of Heroku's archive storage.
GEO_ARCHIVES_URL=https://github.com/thibault/heroku-geo-buildpack/releases/download
# Compile fiona against the GDAL above, not the older copy its wheel embeds.
PIP_NO_BINARY=fiona
